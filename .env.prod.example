# ==============================================================================
# DocIntel Production Environment Template (Google Cloud / VPS)
# Copy to .env on your production server (or run ./deploy/gcp/deploy.sh, which
# auto-generates cryptographic secrets marked [AUTO-GENERATED BY deploy.sh]).
# ==============================================================================

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
ENABLE_SWAGGER_IN_PROD=false

# Cryptographic JWT signing key [AUTO-GENERATED BY deploy.sh via openssl rand -hex 32]
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_FROM_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_SECONDS=900

# PostgreSQL (pgvector) [PASSWORD AUTO-GENERATED BY deploy.sh]
POSTGRES_USER=docintel_prod
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=docintel
DATABASE_URL=postgresql+asyncpg://docintel_prod:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/docintel
DATABASE_URL_SYNC=postgresql+psycopg2://docintel_prod:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/docintel

# Redis (authenticated) [PASSWORD AUTO-GENERATED BY deploy.sh]
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/0

# Object Storage (Internal SeaweedFS S3 [KEYS AUTO-GENERATED BY deploy.sh] OR GCS HMAC keys)
# To use Google Cloud Storage instead of local SeaweedFS, set S3_ENDPOINT_URL=https://storage.googleapis.com
# and insert HMAC keys from GCP Console -> Cloud Storage -> Settings -> Interoperability.
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=REPLACE_WITH_S3_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_S3_SECRET_KEY
S3_BUCKET_NAME=docintel-documents
S3_REGION=us-central1

# Public URL, TLS & Frontend Build Options [FRONTEND_URL AUTO-FILLED BY deploy.sh]
# Leave NEXT_PUBLIC_API_URL empty ("") when served behind Nginx reverse proxy on the same origin.
FRONTEND_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DEMO_MODE=false
INTERNAL_API_URL=http://api:8000
SSL_CERT_DIR=/etc/letsencrypt

# LLM Providers [FILL IN AT LEAST ONE REAL KEY ON YOUR END]
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_MODEL=groq/qwen/qwen3.8-27b
FALLBACK_LLM_MODEL=gemini/gemini-3.5-flash-lite

# Embeddings & Hybrid Retrieval Tuning
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RETRIEVAL_VERSION=v3
DENSE_TOP_K=20
SPARSE_TOP_K=20
FUSION_TOP_N=30
FINAL_RERANK_TOP_K=6
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.97

# Multi-Tenancy Quotas & Upload Limits (50 MB default)
DEFAULT_MONTHLY_TOKEN_BUDGET=1000000
MAX_FILE_SIZE_BYTES=52428800

# Observability [FILL IN LANGFUSE KEYS IF YOU WANT PRODUCTION TRACING]
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_HOST=https://us.cloud.langfuse.com
PROMETHEUS_METRICS_ENABLED=true
