# ==========================================
# DocIntel Environment Configuration
# ==========================================

# Environment Mode: development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Security & JWT Secrets (Change these in production!)
SECRET_KEY=change-this-ultra-secure-random-secret-key-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL 16 with pgvector)
POSTGRES_USER=docintel_admin
POSTGRES_PASSWORD=docintel_secure_pass
POSTGRES_DB=docintel
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://docintel_admin:docintel_secure_pass@localhost:5432/docintel
DATABASE_URL_SYNC=postgresql+psycopg2://docintel_admin:docintel_secure_pass@localhost:5432/docintel

# Redis (Celery Broker, Results & Semantic Cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO S3 Compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=docintel-documents
S3_REGION=us-east-1

# LLM Providers (LiteLLM Router)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_LLM_MODEL=groq/llama-3.3-70b-versatile
FALLBACK_LLM_MODEL=gemini/gemini-2.0-flash

# Embeddings & Re-ranker
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# RAG Pipeline Configuration
RETRIEVAL_VERSION=v3
DENSE_TOP_K=20
SPARSE_TOP_K=20
FUSION_TOP_N=30
FINAL_RERANK_TOP_K=6
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.97

# Multi-Tenancy & Token Budgets
DEFAULT_MONTHLY_TOKEN_BUDGET=1000000

# Tracing & Telemetry
LANGFUSE_PUBLIC_KEY=pk-lf-docintel-demo
LANGFUSE_SECRET_KEY=sk-lf-docintel-demo
LANGFUSE_HOST=http://localhost:3001
PROMETHEUS_METRICS_ENABLED=true

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
