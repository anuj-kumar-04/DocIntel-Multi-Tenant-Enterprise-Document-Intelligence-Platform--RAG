# ==============================================================================
# DocIntel Local Development Environment Template
# Copy to .env (`cp .env.example .env`) and fill in any API keys you want to use.
# ==============================================================================

# Environment Mode: development | test | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
ENABLE_SWAGGER_IN_PROD=false

# Security & JWT Secrets (Change before any non-local deployment!)
SECRET_KEY=dev-docintel-super-secret-key-32-chars-long-minimum-jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_SECONDS=900

# Database Configuration (PostgreSQL 16 + pgvector)
# Note: docker-compose.yml overrides host to @db:5432 inside containers;
# keep localhost here for host scripts (alembic, pytest, seed.py).
POSTGRES_USER=docintel_admin
POSTGRES_PASSWORD=docintel_secure_pass
POSTGRES_DB=docintel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://docintel_admin:docintel_secure_pass@localhost:5432/docintel
DATABASE_URL_SYNC=postgresql+psycopg2://docintel_admin:docintel_secure_pass@localhost:5432/docintel

# Redis (Celery Broker, Token Revocation, Lockout & Semantic Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage (Local SeaweedFS S3 / MinIO-compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=docintel-documents
S3_REGION=us-east-1
# Optional override directory when S3 is unreachable:
# STORAGE_DATA_DIR=

# LLM Providers (LiteLLM Cascade: Groq -> Gemini -> OpenAI -> Local Grounded Engine)
# Leave empty if unused so the router skips straight to configured providers / local engine.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_MODEL=groq/qwen/qwen3.8-27b
FALLBACK_LLM_MODEL=gemini/gemini-3.5-flash-lite

# Embeddings & Cross-Encoder Re-ranker
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# RAG Pipeline & Upload Limits
RETRIEVAL_VERSION=v3
DENSE_TOP_K=20
SPARSE_TOP_K=20
FUSION_TOP_N=30
FINAL_RERANK_TOP_K=6
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.97
MAX_FILE_SIZE_BYTES=52428800

# Multi-Tenancy & Token Budgets
DEFAULT_MONTHLY_TOKEN_BUDGET=1000000

# Observability (Langfuse Cloud v4 OTel + Prometheus + Grafana)
# Obtain Langfuse keys from https://us.cloud.langfuse.com (or leave empty to disable tracing).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_HOST=https://us.cloud.langfuse.com
PROMETHEUS_METRICS_ENABLED=true
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false

# Frontend & CORS
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
INTERNAL_API_URL=http://api:8000
